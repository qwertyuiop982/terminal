@@ -36,6 +38,62 @@
 #include <dpkg/buffer.h>
 #include <dpkg/file.h>
 
+int
+file_link_or_copy(const char *src, const char *dst)
+{
+#ifndef __ANDROID__
+	return link(src, dst);
+#else
+	struct stat st;
+	char *temporary;
+	char buffer[32768];
+	int input = -1, output = -1, result = -1, saved_errno;
+	ssize_t count;
+
+	/* Preserve link()'s no-overwrite contract and do not follow source symlinks. */
+	if (lstat(dst, &st) == 0) { errno = EEXIST; return -1; }
+	if (errno != ENOENT) return -1;
+	input = open(src, O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+	if (input < 0) return -1;
+	if (fstat(input, &st) < 0) { saved_errno = errno; close(input); errno = saved_errno; return -1; }
+	if (!S_ISREG(st.st_mode)) { close(input); errno = EOPNOTSUPP; return -1; }
+
+	temporary = str_fmt("%s-copy.XXXXXX", dst);
+	output = mkstemp(temporary);
+	if (output < 0) goto done;
+	while (1) {
+		count = read(input, buffer, sizeof(buffer));
+		if (count < 0 && errno == EINTR) continue;
+		if (count < 0) goto done;
+		if (count == 0) break;
+		ssize_t offset = 0;
+		while (offset < count) {
+			ssize_t written = write(output, buffer + offset, count - offset);
+			if (written < 0 && errno == EINTR) continue;
+			if (written <= 0) { if (written == 0) errno = EIO; goto done; }
+			offset += written;
+		}
+	}
+	/* Backups remain owned by this app; no root chown or permission broadening. */
+	if (fchmod(output, st.st_mode & 0777) < 0 || fsync(output) < 0) goto done;
+	if (close(output) < 0) { output = -1; goto done; }
+	output = -1;
+	if (lstat(dst, &st) == 0) { errno = EEXIST; goto done; }
+	if (errno != ENOENT) goto done;
+	if (rename(temporary, dst) < 0) goto done;
+	result = 0;
+
+done:
+	saved_errno = errno;
+	if (output >= 0) close(output);
+	close(input);
+	if (result < 0) unlink(temporary);
+	free(temporary);
+	errno = saved_errno;
+	return result;
+#endif
+}
